title = "THE STORM"
hint = "Turn the sailor's table into one rule, biggest wind first: if wind >= 7 the sails are 0, else if wind >= 3 they are 1, else 2. Then get on board."
blanks = "if (wind >= _) { sails = _; } else if (wind >= _) { sails = _; } else { sails = _; }"
answer = "if (wind >= 7) { sails = 0; } else if (wind >= 3) { sails = 1; } else { sails = 2; }"

