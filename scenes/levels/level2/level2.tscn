[node name="Room0_THE_WIDE_GAP" type="Area2D" parent="Rooms" unique_id=1271041085 instance=ExtResource("7_mr1px")]
position = Vector2(496, 176)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(992, 352)
title = "THE WIDE GAP"
hint = "Only Chelzy's wall jump climbs the shaft. Up top, the crawlspace is too low to jump over the gap - only Sarah's dash crosses it: walk to the edge and press Shift. Store Sarah's name in a String called hero."
blanks = "String hero = \"_____\";"
answer = "String hero = \"Sarah\";"
teaches = PackedStringArray("hero", "hasSword")

[node name="Room1_THE_BROKEN_BRIDGE" type="Area2D" parent="Rooms" unique_id=644161940 instance=ExtResource("7_mr1px")]
position = Vector2(1488, 160)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(992, 384)
title = "THE BROKEN BRIDGE"
hint = "Count the gap: it is 8 planks wide. Store that whole number in an int called bridgeLength. Then the planks over the water are too high for one jump - switch to April, and since hero already exists, leave out the type."
blanks = "int bridgeLength = _;"
answer = "int bridgeLength = 8;"
teaches = PackedStringArray("bridgeLength")

[node name="Room2_THE_HIGH_LEDGE" type="Area2D" parent="Rooms" unique_id=1236047678 instance=ExtResource("7_mr1px")]
position = Vector2(2480, -48)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(992, 352)
title = "THE HIGH LEDGE"
hint = "Kervin can sprint over the falling floor - hold Shift while running. The planks up high are too high even for a double jump: make your first jump higher with a double called jumpPower (1.0 to 1.5 - it needs a decimal point), then double jump as April under them."
blanks = "double jumpPower = ___;"
answer = "double jumpPower = 1.5;"
teaches = PackedStringArray("jumpPower")

[node name="Room3_THE_SHIP" type="Area2D" parent="Rooms" unique_id=2041020787 instance=ExtResource("7_mr1px")]
position = Vector2(3632, -144)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(1312, 416)
title = "THE SHIP"
hint = "Only tiny Psalm fits under the beams: switch to him and hold Down. The ship is anchored: pull the anchor up with a boolean called anchorUp (true or false, no quotes), then ride it across. A crab blocks the tunnel on the far side and you can't jump over it: give yourself a sword with another boolean, hasSword, and left-click to swing. Chelzy climbs the shaft to the exit."
blanks = "boolean anchorUp = ____;"
answer = "boolean anchorUp = true;"
teaches = PackedStringArray("anchorUp")

[node name="Room4_THREE_PATHS" type="Area2D" parent="Rooms" unique_id=952451107 instance=ExtResource("7_mr1px")]
position = Vector2(4784, -176)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(992, 352)
title = "THREE PATHS"
hint = "The sign's riddle: the 2nd letter of the alphabet. Choose it with a char called path - single quotes! A wrong path falls into the sea as soon as you stand on it. The falling floor at the end needs Kervin's sprint."
blanks = "char path = '_';"
answer = "char path = 'B';"
teaches = PackedStringArray("path")

[node name="Room5_THE_LOW_CAVE" type="Area2D" parent="Rooms" unique_id=1962348239 instance=ExtResource("7_mr1px")]
position = Vector2(5712, -224)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(864, 256)
title = "EXAM 1: THE LOW CAVE"
hint = "With a high jumpPower every jump hits the ceiling spikes. Change jumpPower back to 1.0. Then only Psalm fits under the beams, and only Kervin's sprint makes it over the falling floor."
blanks = "jumpPower = ___;"
answer = "jumpPower = 1.0;"
zone = "exam"
music = "final_exam"
teaches = PackedStringArray()

[node name="Room6_THE_LOW_BRIDGE" type="Area2D" parent="Rooms" unique_id=566058668 instance=ExtResource("7_mr1px")]
position = Vector2(6640, -304)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(992, 416)
title = "EXAM 2: THE LOW BRIDGE"
hint = "This gap is 6 planks wide. bridgeLength already exists - give it the new number. Then the safe path is the 3rd letter: change path (single quotes!) - a wrong path falls. Chelzy climbs the shaft at the end."
blanks = "bridgeLength = _;"
answer = "bridgeLength = 6;"
zone = "exam"
music = "final_exam"
teaches = PackedStringArray()

[node name="Room7_THE_TREASURE" type="Area2D" parent="Rooms" unique_id=864879792 instance=ExtResource("7_mr1px")]
position = Vector2(7760, -336)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("8_qxm2w")
size = Vector2(1248, 352)
title = "EXAM 3: THE TREASURE"
hint = "This ship is anchored too: anchorUp already exists, so set it without the type and ride across. Print exactly: I can code! Then Captain Clown Nose guards the treasure. Have your sword (hasSword), switch heroes with Q to dodge him - April jumps his charge, tiny Psalm ducks his thrown sword, Sarah dashes from his swing - and hit him while he's dizzy."
blanks = "anchorUp = ____;"
answer = "anchorUp = true;"
zone = "exam"
music = "final_exam"
teaches = PackedStringArray()

