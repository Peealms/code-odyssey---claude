[node name="Room0_THE_TWO_DOORS" type="Area2D" parent="Rooms" unique_id=207034064 instance=ExtResource("6_mr1px")]
position = Vector2(432, 192)
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("7_qxm2w")
size = Vector2(864, 384)
title = "THE TWO DOORS"
hint = "The doors follow the captain's rule: if key is 7 the right door opens, otherwise the left one does. Make an int called key and store 7 in it. Coins are behind both doors, so try another number too."
blanks = "int key = _;"
answer = "int key = 7;"

