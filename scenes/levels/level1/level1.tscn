hint = "Virtual Guy can sprint over the falling floor - hold Shift while running. The ledge is too high even for a double jump: make every jump higher with a double called jumpPower (1.0 to 2.0), then double jump as Mask Dude."
blanks = "double jumpPower = ___;"
answer = "double jumpPower = 1.5;"
background = ExtResource("36_bowig")

[node name="Room_THE_FAN_SHAFT" type="Area2D" parent="Rooms" unique_id=672974386 instance=ExtResource("31_4wm7j")]
