title = "THE WIDE GAP"
hint = "The crawlspace is too low to jump over the gap - only Pink Man's dash crosses it: walk to the edge and press Shift. Store his name in a String called hero."
blanks = "String hero = \"_______\";"
answer = "String hero = \"PinkMan\";"
