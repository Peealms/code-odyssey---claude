title = "THE BROKEN BRIDGE"
hint = "Count the gap: it is 11 blocks wide. Store that whole number in an int called bridgeLength. Then the step is too high for one jump - switch to Mask Dude, and since hero already exists, leave out the type."
blanks = "int bridgeLength = __;"
answer = "int bridgeLength = 11;"
background = ExtResource("35_uji8r")

[node name="Room_THE_HIGH_LEDGE" type="Area2D" parent="Rooms" unique_id=1455057535 instance=ExtResource("31_4wm7j")]
